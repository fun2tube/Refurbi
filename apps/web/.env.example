# Public API base URL (the FastAPI service). Required outside local dev.
NEXT_PUBLIC_API_URL=
# Public site origin used for canonical URLs / sitemap (e.g. https://www.example.in).
NEXT_PUBLIC_SITE_URL=
# PLACEHOLDER WhatsApp number, digits with country code (e.g. 919999999999). Founder to supply the real one.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Analytics (T35, free). GA4 loads only after visitor consent; Cloudflare Web Analytics is cookieless. Leave empty to disable.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CF_BEACON_TOKEN=
