# Copy to .env for local dev. Placeholders only - never commit real secrets.
DATABASE_URL=postgresql+psycopg://refurbi:refurbi_dev_password@localhost:5432/refurbi
APP_ENV=dev
LOG_LEVEL=INFO
# Auth (placeholders - set real values outside dev)
JWT_SECRET=change-me-to-a-long-random-string
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me
# IMEI protection (placeholders). Generate a key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMEI_ENCRYPTION_KEYS is comma-separated, newest first (rotation: prepend new key, re-encrypt, drop old).
# IMEI_ENCRYPTION_KEYS=
# IMEI_HASH_KEY=
# Comma-separated web origins allowed by CORS (e.g. http://localhost:3000). Empty = no CORS.
# CORS_ORIGINS=
# APP_ENV=preview adds demo data on `python -m app.seed` and shows the "Demo data" banner in web.
